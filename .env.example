# ---------------------------------------------------------------------------
# Bore website — environment template
# Copy to `.env.local` for local development (Vite) and add the same values in
# the Vercel project settings. Never commit a filled-in copy of this file.
# ---------------------------------------------------------------------------

# Bot API — the separately hosted Flask service that ships with the Bore bot
# (routes: /commands, /status, /stats, /shards). Without it the site shows an
# honest "service unavailable" state instead of fabricated numbers.
BOT_API_BASE_URL=https://your-bot-api.example.com

# Shared secret for the bot API. The bot's Flask service accepts it in the
# `X-API-Key` header (set `API_KEY` or `API_KEY_FILE` on the bot host).
# Leave empty if the bot API runs without authentication.
BOT_API_KEY=

# Discord application id of the BOT itself, used to build an "add Bore to this
# server" link for servers where the bot is not installed. It is not the OAuth
# application id below — it is the application the bot user was created under
# (the first part of the bot token, or the app id in the developer portal).
BOT_CLIENT_ID=

# Discord OAuth2 application (server-side only, never exposed to the browser).
# Create one at https://discord.com/developers/applications and add
# <your-domain>/api/auth/callback as a redirect URI.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://your-site.example.com/api/auth/callback

# Secret used to encrypt the session cookie. Use 32+ random characters:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# PostgreSQL connection string for the bot database (server-side only).
# Only the `prefix` table is read, and only for servers the signed-in user is in.
DATABASE_URL=postgresql://user:password@host:5432/bore?sslmode=require

# Public site origin, used for OAuth redirects and absolute links.
SITE_URL=https://your-site.example.com

# ---------------------------------------------------------------------------
# Public (VITE_ prefixed) variables — these are bundled into the browser code.
# ---------------------------------------------------------------------------

# Invite link used by the "Add to Discord" buttons.
VITE_DISCORD_INVITE_URL=https://bore.best/discord

# Support server link shown in the footer.
VITE_SUPPORT_URL=https://bore.best/discord
